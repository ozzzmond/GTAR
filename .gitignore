# Built application files
*.apk
*.aar
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/
buildOutputCleanup/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA files
*.iml
.idea/
.idea/caches
.idea/libraries
.idea/modules.xml
.idea/workspace.xml

# Keystore files
*.jks
*.keystore
!app/debug.keystore

# External native build folder
.externalNativeBuild
.cxx/

# Google Services (if applicable)
google-services.json

# OS-specific files
.DS_Store
Thumbs.db

# Kotlin compilation cache
.kotlin/

*.jks
keystore_base64.txt

# Web companion app
web/node_modules/
web/dist/
__pycache__/

.npm-cache/
lint-results.json

# Offline test evidence, task receipts, and diagnostic dumps
/outputs/*
!/outputs/.gitkeep
