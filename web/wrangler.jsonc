        "VITE_ROOT_ADMIN_EMAIL": "jlopez3rd@gmail.com",
        "VITE_AUTHORIZED_EMAILS": "jlopez3rd@gmail.com,jlopezturk@gmail.com,akojep@gmail.com,jajamorano@gmail.com,johncriscaculitan01@gmail.com,michael.intal@gmail.com,princediaznarciso@gmail.com"
