{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtar",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtar-db-prod",
      "database_id": "c2e87762-5fdb-4eb0-bd13-55877778aa87",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      "compatibility_flags": [
        "nodejs_compat"
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gtar-db-prod",
          "database_id": "c2e87762-5fdb-4eb0-bd13-55877778aa87",
          "migrations_dir": "migrations"
        }
      ]
    },
    "preview": {
      "compatibility_flags": [
        "nodejs_compat"
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gtar-db-dev",
          "database_id": "455b9901-9018-4e73-9ac1-a684f7335def",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
