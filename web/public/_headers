# Cloudflare Pages Custom Headers for GTAR Web
# https://developers.cloudflare.com/pages/configuration/headers/

# 1. Service Worker - NEVER cache sw.js to ensure immediate update detection
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8
  X-Content-Type-Options: nosniff

# 2. PWA Manifests - Always fetch fresh manifest metadata
/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

# 3. HTML Entrypoint - Always revalidate so browsers discover new hashed bundles
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/html; charset=utf-8
  X-Content-Type-Options: nosniff

# 4. Hashed Static Assets - Immutable 1-year cache (cache-busted by Vite content hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
